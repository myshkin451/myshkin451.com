{
  "name": "myshkin451.com",
  "version": "1.0.0",
  "description": "Personal digital platform for Myshkin 451.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "db:down": "docker compose down",
    "db:up": "docker compose up -d db",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "frontend:preview": "vite preview --config frontend/vite.config.ts",
    "frontend:test": "vitest run --config frontend/vitest.config.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "site:dev": "next dev site --webpack -p 4325 -H 127.0.0.1",
    "site:build": "next build site --webpack",
    "site:start": "next start site -p 4325 -H 127.0.0.1",
    "site:typecheck": "tsc --noEmit -p site/tsconfig.json",
    "site:test:api": "node scripts/production/local-run.mjs node scripts/production/api-test.mjs",
    "site:test:accounts": "node scripts/production/local-run.mjs node scripts/production/accounts-test.mjs",
    "site:test:backup": "node --test scripts/production/backup.test.mjs scripts/production/linked-backup.test.mjs",
    "site:local:configure": "node scripts/production/configure-local.mjs",
    "site:db:start": "supabase start -x studio,imgproxy,realtime,edge-runtime,logflare,vector,supavisor"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@supabase/supabase-js": "^2.116.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "payload": "3.84.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "28.0.0",
    "postcss": "8.5.6",
    "prettier": "^3.4.2",
    "supabase": "^2.117.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
